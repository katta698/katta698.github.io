# Python bytecode — regenerated on every sync_blog.py run
__pycache__/
*.py[cod]

# Output of `aws lambda invoke` in the publish workflows
response.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Generated each morning by scripts/morning.py -- a local briefing, not content.
MORNING.md

# Built by scripts/build_monthly_report.py. An internal document for a manager,
# not blog content -- the script and the analysis sidecar are tracked, the
# rendered report is not. Keeping it out of the tree also stops publish.py
# seeing a stray file on every run.
reports/out/
